{
  "name": "png-dhash-duplicate-detector",
  "version": "1.0.0",
  "description": "本地 PNG 近似重复检测后端（TypeScript + Node.js + SQLite，自研 64 位 dHash）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts serve",
    "serve": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts demo",
    "generate-samples": "tsx src/cli.ts generate-samples",
    "test": "node --import tsx --test test/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
